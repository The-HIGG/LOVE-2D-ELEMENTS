{
  "compilerOptions": {
    "target": "es2022",
    "moduleResolution": "node",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["esnext"],
    "rootDir": ".",
    "outDir": "game",
    "types": [
      "lua-types/jit",
      "love-typescript-definitions",
      "@typescript-to-lua/language-extensions"
    ]
  },
  "include": [
    "libs/**/*",
    "src/**/*"
  ],
  "tstl": {
    "luaLibImport": "require",
    "luaTarget": "JIT",
    "noImplicitSelf": true,
    "sourceMapTraceback": true,
    "noResolvePaths": ["bit", "ffi"]
  }
}
